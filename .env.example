# Telegram Bot (required for the Bot UI — get from @BotFather)
TELEGRAM_BOT_TOKEN=
OWNER_ID=

# Telegram Userbot / Listener (required ONLY for channel scanning — Section 7).
# Leave both empty to run Bot UI + Manual Forward Intake only (Section 7.3
# graceful degradation) — this is a safe, fully functional starting mode.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# The scanner will NOT start even with the two values above set unless this
# is also "yes". Set it only after you've read Master Prompt Section 7.4 and
# reviewed Telegram's current API Terms of Service for using API-obtained
# data with an AI classifier — this is a platform-policy question the code
# cannot resolve for you (see Governing Resolution Rule 7).
TELEGRAM_TOS_ACKNOWLEDGED=no

# Email sending (required for the Application send action — Section 12.3)
# NOTE: there is NO shared/fallback email account. Every user links their
# OWN email + their own App Password from inside the bot (👤 حسابي → ربط
# إيميلي). The key below is only used to encrypt those per-user App
# Passwords at rest — generate one once and never change it (changing it
# makes all previously-stored passwords undecryptable, forcing every user
# to re-link):
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Optional: enables AI-assisted classification alongside the rule engine.
# Without this, the bot runs on the rule-based classifier only — fully
# functional, just less semantically flexible on unusual phrasing.
ANTHROPIC_API_KEY=

# Optional
DATABASE_PATH=job_hunter.db
